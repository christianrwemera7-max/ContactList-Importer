
{
  "entities": {
    "Profile": {
      "title": "KONEKT ID",
      "description": "Identité numérique et professionnelle du membre.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "profession": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "lookingFor": { "type": "array", "items": { "type": "string" } },
        "konektScore": { "type": "number", "default": 0 },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "payment_late", "suspended", "alumni"] },
        "currentTier": { "type": "string", "enum": ["START", "PLUS", "PRO"] },
        "role": { "type": "string", "enum": ["member", "leader", "zone_coordinator", "regional_coordinator", "national"] },
        "currentCellId": { "type": "string" },
        "badges": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "type": { "type": "string" },
              "grantedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "status", "currentTier", "role"]
    },
    "Cell": {
      "title": "Cellule numérique",
      "description": "Unité de base et mini-organisation de 20 membres.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "zoneId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "leaderMemberId": { "type": "string" },
        "activityRate": { "type": "number", "default": 0 },
        "nextMeetingAt": { "type": "string", "format": "date-time" },
        "capacity": { "type": "number", "default": 20 },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "target": { "type": "number" },
              "current": { "type": "number" }
            }
          }
        },
        "locationType": { "type": "string", "enum": ["geographic", "university", "thematic"] },
        "status": { "type": "string", "enum": ["active", "inactive", "forming"] }
      }
    },
    "Project": {
      "title": "KONEKT Project",
      "description": "Projet entrepreneurial porté par des membres.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["idea", "prototype", "launch", "growth"] },
        "requiredSkills": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Post": {
      "title": "KONEKT Flow",
      "description": "Élément du fil d'activation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["community", "opportunity", "learning", "project", "impact"] },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "email"]
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Profile",
      "description": "Profils des membres (KONEKT ID)"
    },
    "/cells/{cellId}": {
      "schema": "Cell",
      "description": "Liste des cellules"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project Lab"
    },
    "/flow/{postId}": {
      "schema": "Post",
      "description": "KONEKT Flow items"
    }
  }
}
