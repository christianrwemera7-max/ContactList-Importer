{
  "entities": {
    "Profile": {
      "title": "KONEKT ID",
      "description": "Identité numérique et professionnelle unique du membre.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "language": { "type": "string" },
        "bio": { "type": "string" },
        "profession": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "payment_late", "suspended", "alumni", "disabled"] },
        "currentTier": { "type": "string", "enum": ["START", "PLUS", "PRO"] },
        "currentCellId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastActivityAt": { "type": "string", "format": "date-time" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "type": "string" } },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "konektScore": { "type": "number", "default": 0 },
        "badges": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "status"]
    },
    "Cell": {
      "title": "Cellule KONEKT",
      "description": "Unité de base de 20 membres maximum.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "zoneId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "leaderMemberId": { "type": "string" },
        "capacity": { "type": "number", "default": 20 },
        "status": { "type": "string", "enum": ["forming", "active", "inactive"] },
        "activityRate": { "type": "number" }
      }
    },
    "RoleAssignment": {
      "title": "Attribution de Rôle",
      "description": "Définit les responsabilités (Leader, Coordinateur, etc.) indépendamment du niveau financier.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "leader", "zone_coordinator", "regional_coordinator", "national"] },
        "scopeId": { "type": "string" },
        "assignedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "revoked", "ended"] }
      }
    },
    "Course": {
      "title": "Formation Academy",
      "description": "Contenu pédagogique structuré en modules et leçons.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string", "enum": ["débutant", "intermédiaire", "avancé"] },
        "minTierRequired": { "type": "string", "enum": ["START", "PLUS", "PRO"] },
        "modulesCount": { "type": "number" },
        "published": { "type": "boolean" }
      }
    },
    "Opportunity": {
      "title": "Opportunité KONEKT",
      "description": "Emplois, stages ou missions vérifiés.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partnerId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["EMPLOI", "STAGE", "MISSION", "FREELANCE", "CONCOURS", "PARTENARIAT", "FINANCEMENT", "PROJET", "ÉVÉNEMENT"] },
        "secteur": { "type": "string" },
        "localisation": { "type": "string" },
        "minTierRequired": { "type": "string", "enum": ["START", "PLUS", "PRO"] },
        "deadline": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "published", "expired"] }
      }
    },
    "Project": {
      "title": "KONEKT Project",
      "description": "Projet entrepreneurial en cours d'incubation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["IDÉE", "SOUMIS", "EN ÉVALUATION", "SÉLECTIONNÉ", "ACCOMPAGNEMENT", "DÉVELOPPEMENT", "ACTIF"] },
        "needs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AuditLog": {
      "title": "Journal d'Audit",
      "description": "Trace de chaque action sensible pour la transparence.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "entityId": { "type": "string" },
        "entityType": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["google", "email"]
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Profile",
      "description": "Profils KONEKT ID"
    },
    "/members/{memberId}/roles/{roleId}": {
      "schema": "RoleAssignment",
      "description": "Historique des responsabilités du membre"
    },
    "/cells/{cellId}": {
      "schema": "Cell",
      "description": "Cellules communautaires"
    },
    "/academy/{courseId}": {
      "schema": "Course",
      "description": "Catalogue de formations"
    },
    "/opportunities/{oppId}": {
      "schema": "Opportunity",
      "description": "Marché des opportunités vérifiées"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Laboratoire de projets"
    },
    "/audit/{logId}": {
      "schema": "AuditLog",
      "description": "Journal système de transparence"
    }
  }
}